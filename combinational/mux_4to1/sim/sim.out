#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fdfbf799d20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fdfbf799eb0 .scope module, "tb_mux_4to1" "tb_mux_4to1" 3 1;
 .timescale 0 0;
v0x5fdfbf7af940_0 .var "data", 3 0;
v0x5fdfbf7afa30_0 .var "sel", 1 0;
v0x5fdfbf7afb00_0 .net "y", 0 0, L_0x5fdfbf7afc00;  1 drivers
S_0x5fdfbf760500 .scope module, "uut" "mux_4to1" 3 7, 4 1 0, S_0x5fdfbf799eb0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /INPUT 2 "sel";
    .port_info 2 /OUTPUT 1 "y";
v0x5fdfbf760730_0 .net "data", 3 0, v0x5fdfbf7af940_0;  1 drivers
v0x5fdfbf7af740_0 .net "sel", 1 0, v0x5fdfbf7afa30_0;  1 drivers
v0x5fdfbf7af820_0 .net "y", 0 0, L_0x5fdfbf7afc00;  alias, 1 drivers
L_0x5fdfbf7afc00 .part/v v0x5fdfbf7af940_0, v0x5fdfbf7afa30_0, 1;
    .scope S_0x5fdfbf799eb0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fdfbf799eb0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5fdfbf799eb0;
T_1 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 14, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 13, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5fdfbf7af940_0, 0, 4;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5fdfbf7afa30_0, 0, 2;
    %delay 10, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5fdfbf799eb0;
T_2 ;
    %vpi_call/w 3 26 "$monitor", "Time=%0t | Data=%b Sel=%b | Y=%b", $time, v0x5fdfbf7af940_0, v0x5fdfbf7afa30_0, v0x5fdfbf7afb00_0 {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
