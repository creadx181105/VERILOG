S_0x58cd6b1fa920 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x58cd6b1faab0 .scope module, "tb_nor_gate" "tb_nor_gate" 3 1;
 .timescale 0 0;
v0x58cd6b20e890_0 .var "a", 0 0;
v0x58cd6b20e960_0 .var "b", 0 0;
v0x58cd6b20ea30_0 .net "y", 0 0, L_0x58cd6b20ec70;  1 drivers
