#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5ee05d353e70 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5ee05d354000 .scope module, "tb_half_adder" "tb_half_adder" 3 2;
 .timescale 0 0;
v0x5ee05d368270_0 .net "carry", 0 0, L_0x5ee05d368580;  1 drivers
v0x5ee05d368330_0 .var "inputs", 1 0;
v0x5ee05d3683f0_0 .net "sum", 0 0, L_0x5ee05d368490;  1 drivers
L_0x5ee05d3686e0 .part v0x5ee05d368330_0, 1, 1;
L_0x5ee05d368780 .part v0x5ee05d368330_0, 0, 1;
S_0x5ee05d31a500 .scope module, "uut" "half_adder" 3 7, 4 2 0, S_0x5ee05d354000;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x5ee05d368490 .functor XOR 1, L_0x5ee05d3686e0, L_0x5ee05d368780, C4<0>, C4<0>;
L_0x5ee05d368580 .functor AND 1, L_0x5ee05d3686e0, L_0x5ee05d368780, C4<1>, C4<1>;
v0x5ee05d31a750_0 .net "a", 0 0, L_0x5ee05d3686e0;  1 drivers
v0x5ee05d367fd0_0 .net "b", 0 0, L_0x5ee05d368780;  1 drivers
v0x5ee05d368090_0 .net "carry", 0 0, L_0x5ee05d368580;  alias, 1 drivers
v0x5ee05d368130_0 .net "sum", 0 0, L_0x5ee05d368490;  alias, 1 drivers
    .scope S_0x5ee05d354000;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5ee05d354000 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5ee05d354000;
T_1 ;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5ee05d368330_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5ee05d368330_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5ee05d368330_0, 0, 2;
    %delay 10, 0;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5ee05d368330_0, 0, 2;
    %delay 10, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5ee05d354000;
T_2 ;
    %vpi_call/w 3 26 "$monitor", "Time=%0t | A=%b B=%b | Sum=%b Carry=%b", $time, &PV<v0x5ee05d368330_0, 1, 1>, &PV<v0x5ee05d368330_0, 0, 1>, v0x5ee05d3683f0_0, v0x5ee05d368270_0 {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_half_adder.v";
    "rtl/half_adder.v";
