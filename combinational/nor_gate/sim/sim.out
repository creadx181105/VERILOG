v0x58cd6b20e6b0_0 .net "b", 0 0, v0x58cd6b20e960_0;  1 drivers
v0x58cd6b20e750_0 .net "y", 0 0, L_0x58cd6b20ec70;  alias, 1 drivers
    .scope S_0x58cd6b1faab0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58cd6b1faab0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x58cd6b1faab0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58cd6b20e890_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58cd6b20e960_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58cd6b20e890_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58cd6b20e960_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58cd6b20e890_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58cd6b20e960_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58cd6b20e890_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58cd6b20e960_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x58cd6b1faab0;
T_2 ;
    %vpi_call/w 3 21 "$monitor", "Time=%0t | A=%b B=%b | Y=%b", $time, v0x58cd6b20e890_0, v0x58cd6b20e960_0, v0x58cd6b20ea30_0 {0 0 0};
    %end;
