#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56b36ee9bbf0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56b36ee9bd80 .scope module, "tb_2_in_mux" "tb_2_in_mux" 3 2;
 .timescale -9 -12;
v0x56b36eeb0de0_0 .var "inputs", 2 0;
v0x56b36eeb0ee0_0 .net "out", 0 0, L_0x56b36eeb0fa0;  1 drivers
L_0x56b36eeb1090 .part v0x56b36eeb0de0_0, 2, 1;
L_0x56b36eeb1180 .part v0x56b36eeb0de0_0, 1, 1;
L_0x56b36eeb12c0 .part v0x56b36eeb0de0_0, 0, 1;
S_0x56b36ee62500 .scope module, "uut" "mux_2in" 3 6, 4 1 0, S_0x56b36ee9bd80;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "out";
v0x56b36ee62750_0 .net "a", 0 0, L_0x56b36eeb1090;  1 drivers
v0x56b36eeb0b40_0 .net "b", 0 0, L_0x56b36eeb1180;  1 drivers
v0x56b36eeb0c00_0 .net "out", 0 0, L_0x56b36eeb0fa0;  alias, 1 drivers
v0x56b36eeb0ca0_0 .net "sel", 0 0, L_0x56b36eeb12c0;  1 drivers
L_0x56b36eeb0fa0 .functor MUXZ 1, L_0x56b36eeb1090, L_0x56b36eeb1180, L_0x56b36eeb12c0, C4<>;
    .scope S_0x56b36ee9bd80;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56b36ee9bd80 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x56b36ee9bd80;
T_1 ;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 5, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 6, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 7, 0, 3;
    %store/vec4 v0x56b36eeb0de0_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x56b36ee9bd80;
T_2 ;
    %vpi_call/w 3 29 "$monitor", "Time=%0t | A=%b B=%b Sel=%b | Out=%b", $time, &PV<v0x56b36eeb0de0_0, 2, 1>, &PV<v0x56b36eeb0de0_0, 1, 1>, &PV<v0x56b36eeb0de0_0, 0, 1>, v0x56b36eeb0ee0_0 {0 0 0};
    %end;
    .thread T_2;
