v0x5b66e79b96e0_0 .net "difference", 0 0, L_0x5b66e79b9a70;  alias, 1 drivers
    .scope S_0x5b66e79a5040;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5b66e79a5040 {0 0 0};
    %end;
    .thread T_0;
