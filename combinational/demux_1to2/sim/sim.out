#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a0d0fb06eb0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a0d0fb07040 .scope module, "tb_demux_1to2" "tb_demux_1to2" 3 1;
 .timescale 0 0;
v0x5a0d0fb1b3d0_0 .var "data", 0 0;
v0x5a0d0fb1b490_0 .var "sel", 0 0;
v0x5a0d0fb1b530_0 .net "y0", 0 0, L_0x5a0d0fb1b7f0;  1 drivers
v0x5a0d0fb1b630_0 .net "y1", 0 0, L_0x5a0d0fb1b950;  1 drivers
S_0x5a0d0facd500 .scope module, "uut" "demux_1to2" 3 8, 4 1 0, S_0x5a0d0fb07040;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "data";
    .port_info 1 /INPUT 1 "sel";
    .port_info 2 /OUTPUT 1 "y0";
    .port_info 3 /OUTPUT 1 "y1";
L_0x5a0d0fb1b700 .functor NOT 1, v0x5a0d0fb1b490_0, C4<0>, C4<0>, C4<0>;
L_0x5a0d0fb1b7f0 .functor AND 1, v0x5a0d0fb1b3d0_0, L_0x5a0d0fb1b700, C4<1>, C4<1>;
L_0x5a0d0fb1b950 .functor AND 1, v0x5a0d0fb1b3d0_0, v0x5a0d0fb1b490_0, C4<1>, C4<1>;
v0x5a0d0facd750_0 .net *"_ivl_0", 0 0, L_0x5a0d0fb1b700;  1 drivers
v0x5a0d0fb1b020_0 .net "data", 0 0, v0x5a0d0fb1b3d0_0;  1 drivers
v0x5a0d0fb1b0e0_0 .net "sel", 0 0, v0x5a0d0fb1b490_0;  1 drivers
v0x5a0d0fb1b180_0 .net "y0", 0 0, L_0x5a0d0fb1b7f0;  alias, 1 drivers
v0x5a0d0fb1b240_0 .net "y1", 0 0, L_0x5a0d0fb1b950;  alias, 1 drivers
    .scope S_0x5a0d0fb07040;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a0d0fb07040 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0d0fb1b3d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0d0fb1b490_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0d0fb1b3d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0d0fb1b490_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0d0fb1b3d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0d0fb1b490_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0d0fb1b3d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0d0fb1b490_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a0d0fb07040;
T_1 ;
    %vpi_call/w 3 22 "$monitor", "Time=%0t | Data=%b Sel=%b | Y0=%b Y1=%b", $time, v0x5a0d0fb1b3d0_0, v0x5a0d0fb1b490_0, v0x5a0d0fb1b530_0, v0x5a0d0fb1b630_0 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_demux_1to2.v";
    "rtl/demux_1to2.v";
