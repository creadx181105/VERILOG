#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x585a21a5d8e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x585a21a5da70 .scope module, "tb_or_gate" "tb_or_gate" 3 1;
 .timescale 0 0;
v0x585a21a713f0_0 .var "a", 0 0;
v0x585a21a714c0_0 .var "b", 0 0;
v0x585a21a71590_0 .net "y", 0 0, L_0x585a21a71690;  1 drivers
S_0x585a21a24500 .scope module, "uut" "or_gate" 3 6, 4 1 0, S_0x585a21a5da70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x585a21a71690 .functor OR 1, v0x585a21a713f0_0, v0x585a21a714c0_0, C4<0>, C4<0>;
v0x585a21a24730_0 .net "a", 0 0, v0x585a21a713f0_0;  1 drivers
v0x585a21a71210_0 .net "b", 0 0, v0x585a21a714c0_0;  1 drivers
v0x585a21a712d0_0 .net "y", 0 0, L_0x585a21a71690;  alias, 1 drivers
    .scope S_0x585a21a5da70;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x585a21a5da70 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x585a21a5da70;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x585a21a713f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x585a21a714c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x585a21a713f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x585a21a714c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x585a21a713f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x585a21a714c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x585a21a713f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x585a21a714c0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x585a21a5da70;
T_2 ;
    %vpi_call/w 3 21 "$monitor", "Time=%0t | A=%b B=%b | Y=%b", $time, v0x585a21a713f0_0, v0x585a21a714c0_0, v0x585a21a71590_0 {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_or_gate.v";
    "rtl/or_gate.v";
